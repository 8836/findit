# ---------------------------------------------------------------------------
# FindIt environment variables
# Copy this file to `.env.local` and replace every value with your own.
# Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Firebase Web App (required for the client / web app) ---
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Cloudinary (image uploads) ---
# Cloudinary Console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Preset used by the bots (Cloudinary Console -> Settings -> Upload -> unsigned preset)
CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# --- Telegram bot ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...your-token
TELEGRAM_BOT_USERNAME=findit_bot

# --- WhatsApp bot (Twilio) ---
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
# A random string you choose; Twilio sends it during webhook verification
WHATSAPP_VERIFY_TOKEN=your_random_verify_token

# --- Public base URL used by webhook helpers ---
# Set this to the deployed URL (e.g. https://findit.vercel.app)
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# --- Email notifications (Firebase Functions) ---
# A Gmail account with an App Password (or any SMTP account)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# --- Optional development tweaks ---
# Comma-separated list of extra hosts allowed to reach the Next.js dev server
NEXT_PUBLIC_DEV_ORIGINS=
